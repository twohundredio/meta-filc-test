--- a/lib/shadow/gshadow/fgetsgent.c	2026-03-01 17:57:26.389026603 +0200
+++ b/lib/shadow/gshadow/fgetsgent.c	2026-11-01 10:04:54.590209127 +0200
@@ -29,7 +29,7 @@
  * fgetsgent() reads the next line from the provided stream and
  * converts it to a (struct sgrp).  NULL is returned on EOF.
