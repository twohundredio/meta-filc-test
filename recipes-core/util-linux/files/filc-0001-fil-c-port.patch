Subject: [PATCH] Fil-C port for util-linux

Spell the version-script linker flag as -Wc,--version-script=FILE (filcc
0.687 driver) so pizlonated symbols are exported from the lib*.so.

Upstream-Status: Pending
---
diff -ruN '--exclude=.git' util-linux-2.41.5/libblkid/src/Makemodule.am mod/libblkid/src/Makemodule.am
--- util-linux-2.41.5/libblkid/src/Makemodule.am	2026-06-16 13:59:53.751422695 +0300
+++ mod/libblkid/src/Makemodule.am	2026-10-30 21:58:39.270680240 +0200
@@ -133,7 +133,7 @@
 
 libblkid_la_LDFLAGS = $(SOLIB_LDFLAGS)
 if HAVE_VSCRIPT
-libblkid_la_LDFLAGS += $(VSCRIPT_LDFLAGS),$(top_srcdir)/libblkid/src/libblkid.sym
+libblkid_la_LDFLAGS += -Wc,--version-script=$(top_srcdir)/libblkid/src/libblkid.sym
 endif
 libblkid_la_LDFLAGS += -version-info $(LIBBLKID_VERSION_INFO)
 
