# /etc/network/interfaces -- configuration file for ifup(8), ifdown(8)

# The loopback interface
auto lo
iface lo inet loopback

# Wired interface: DHCP (qemu slirp hands out 10.0.2.15, gw 10.0.2.2), so
# hostfwd ports (e.g. tcp::2222-:22 for sshd) are reachable from the host
auto eth0
iface eth0 inet dhcp
