Subject: [PATCH] Fil-C port for libtasn1

Ported from the upstream Fil-C project tree
(github.com/pizlonator/fil-c, projects/libtasn1-4.21.0).

The version script must be passed as -Wc,--version-script=... so filcc
sees the option itself and pizlonates the exported symbols (fil-c 0.687;
upstream uses the bare --version-script= form). Both Makefile.am and
Makefile.in are patched: Yocto's autotools maintainer mode can regenerate
Makefile.in from Makefile.am.

Upstream-Status: Pending
---
--- a/lib/Makefile.in
+++ b/lib/Makefile.in
@@ -109,7 +109,7 @@
 POST_UNINSTALL = :
 build_triplet = @build@
 host_triplet = @host@
-@HAVE_LD_VERSION_SCRIPT_TRUE@am__append_1 = -Wl,--version-script=$(srcdir)/libtasn1.map
+@HAVE_LD_VERSION_SCRIPT_TRUE@am__append_1 = -Wc,--version-script=$(srcdir)/libtasn1.map
 @HAVE_LD_VERSION_SCRIPT_FALSE@am__append_2 = -export-symbols-regex '^(asn1|libtasn1_).*'
 @HAVE_LD_OUTPUT_DEF_TRUE@am__append_3 = -Wl,--output-def,libtasn1-$(DLL_VERSION).def
 subdir = lib
--- a/lib/Makefile.am
+++ b/lib/Makefile.am
@@ -56,7 +56,7 @@
 
 if HAVE_LD_VERSION_SCRIPT
-libtasn1_la_LDFLAGS += -Wl,--version-script=$(srcdir)/libtasn1.map
+libtasn1_la_LDFLAGS += -Wc,--version-script=$(srcdir)/libtasn1.map
 else
 libtasn1_la_LDFLAGS += -export-symbols-regex '^(asn1|libtasn1_).*'
 endif
