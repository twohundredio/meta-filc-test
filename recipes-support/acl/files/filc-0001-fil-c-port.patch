Subject: [PATCH] Fil-C port for acl

Use -Wc,--version-script (filcc 0.687 driver) so the pizlonated symbols
are exported from libacl.

Upstream-Status: Pending
---
diff -ruN '--exclude=.git' acl-2.3.2/libacl/Makemodule.am mod/libacl/Makemodule.am
--- acl-2.3.2/libacl/Makemodule.am	2022-11-16 16:20:02.000000000 +0200
+++ mod/libacl/Makemodule.am	2026-10-30 20:43:37.020596567 +0200
@@ -79,5 +79,5 @@
 libacl_la_LIBADD = -lattr libmisc.la $(LTLIBINTL)
 libacl_la_CFLAGS = $(AM_CFLAGS) -include $(srcdir)/libacl/perm_copy.h
 libacl_la_LDFLAGS = \
-	-Wl,--version-script,$(top_srcdir)/exports \
+	-Wc,--version-script=$(top_srcdir)/exports \
 	-version-info $(LTVERSION)
diff -ruN '--exclude=.git' acl-2.3.2/Makefile.in mod/Makefile.in
--- acl-2.3.2/Makefile.in	2024-01-24 06:58:12.000000000 +0200
+++ mod/Makefile.in	2026-10-30 20:43:37.020648575 +0200
@@ -875,7 +875,7 @@
 libacl_la_LIBADD = -lattr libmisc.la $(LTLIBINTL)
 libacl_la_CFLAGS = $(AM_CFLAGS) -include $(srcdir)/libacl/perm_copy.h
 libacl_la_LDFLAGS = \
-	-Wl,--version-script,$(top_srcdir)/exports \
+	-Wc,--version-script=$(top_srcdir)/exports \
 	-version-info $(LTVERSION)
 
 libmisc_la_SOURCES = \
